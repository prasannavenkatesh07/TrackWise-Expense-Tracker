# --- Server -------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- MongoDB Atlas ------------------------------------------------------------
# Replace with your Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/expense_tracker?retryWrites=true&w=majority

# --- JWT ----------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# --- CORS ---------------------------------------------------------------------
# Allowed frontend origin (Vite default is 5173)
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- Authentication & Mailing -------------------------------------------------
# OAuth Client ID for Google Sign-In
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Active: SendGrid API for OTP delivery
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_USER=your_verified_sender@example.com

# Fallback: Nodemailer / Gmail App Password (if using the commented-out logic)
# EMAIL_PASS=your_16_character_google_app_password

# --- AI Integration -----------------------------------------------------------
# API key for the RAG-based Chatbot feature
GEMINI_API_KEY=your_google_gemini_api_key

